<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.H2pro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0F2230</item>
        <item name="android:navigationBarColor">#0F2230</item>
        <item name="android:windowBackground">#142A3A</item>
        <item name="colorAccent">#C6A15B</item>
        <item name="android:colorAccent">#C6A15B</item>
        <item name="buttonStyle">@style/Widget.H2pro.Button</item>
        <item name="editTextStyle">@style/Widget.H2pro.EditText</item>
    </style>

    <style name="Widget.H2pro.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#E7C982</item>
        <item name="android:background">@drawable/button_classic</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.H2pro.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#172B3A</item>
        <item name="android:textColorHint">#7B8794</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:background">@drawable/edit_text_border</item>
    </style>
</resources>
